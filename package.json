{
  "name": "outreach-ops",
  "version": "0.4.1",
  "description": "AI prospect research, grading & outreach engine — local-first, draft-only, works with any AI coding CLI (Claude Code, Codex, OpenCode, Qwen)",
  "private": true,
  "scripts": {
    "doctor": "node engine/doctor.mjs",
    "test": "node engine/test-all.mjs",
    "test:quick": "node engine/test-all.mjs --quick",
    "scan": "node engine/scan.mjs",
    "scan:full": "node engine/scan-ats-full.mjs",
    "ledger:verify": "node engine/verify-ledger.mjs",
    "ledger:normalize": "node engine/normalize.mjs",
    "ledger:dedup": "node engine/dedup.mjs",
    "ledger:merge": "node engine/merge.mjs",
    "ledger:reconcile": "node engine/reconcile.mjs",
    "ledger": "node engine/ledger.mjs",
    "find": "node engine/find.mjs",
    "patterns": "node engine/patterns.mjs",
    "cadence": "node engine/cadence.mjs",
    "reposts": "node engine/detect-reposts.mjs",
    "liveness": "node engine/check-liveness.mjs",
    "validate:watch": "node engine/validate-portals.mjs",
    "verify:watch": "node engine/verify-portals.mjs",
    "plugins": "node plugins.mjs",
    "update:check": "node engine/update-system.mjs check",
    "update": "node engine/update-system.mjs apply",
    "rollback": "node engine/update-system.mjs rollback",
    "build:dashboard": "node engine/build-dashboard.mjs",
    "serve:dashboard": "cd dashboard && go run . --path ..",
    "outcomes": "node engine/outcomes.mjs",
    "campaign": "node engine/campaign.mjs",
    "preflight": "node engine/spam-preflight.mjs",
    "deliverability": "node engine/deliverability-doctor.mjs",
    "eval:grading": "node engine/eval-grading.mjs",
    "web": "node web/server.mjs",
    "discover": "node engine/discover.mjs",
    "schedule": "node engine/schedule.mjs"
  },
  "keywords": [
    "ai",
    "outreach",
    "prospecting",
    "lead-generation",
    "sales",
    "job-search",
    "claude-code",
    "agent",
    "local-first"
  ],
  "author": "Haris Hussain Khan (https://github.com/haris-hk)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.62.0"
  }
}